# GITHUB
GITHUB_TOKEN=GITHUB_TOKEN_HERE

# Open AI
OPENAI_API_KEY=OPENAI_API_KEY_HERE
OPENAI_MODEL=YOUR_MODEL_HERE
OPENAI_REASONING_EFFORT=WHATEVER_YOU_WANT
OPENAI_MAX_OUTPUT_TOKENS=512

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=CHANGE_ME
DATABASE_URL="postgresql://portfolio:CHANGE_ME@127.0.0.1:5432/portfolio?schema=public&connect_timeout=5&pool_timeout=5"
# Only DATABASE_URL is used for database connectivity; DB_* above are informational.

# AdminJS
# Run npm run admin:password to generate a password hash. Never use a plaintext password here.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=REPLACE_WITH_GENERATED_SCRYPT_HASH
ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_ORIGIN=http://localhost:3001
PORT=3001

# Railway has one trusted reverse proxy; set to 1 in production only.
TRUST_PROXY=0
