{
    "private": true,
    "type": "module",
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "build": "npm run build --workspace client && npm run build --workspace server",
        "start": "npm run start --workspace server",
        "dev": "npm run dev --workspace server",
        "db:generate": "npm run db:generate --workspace server --",
        "db:migrate": "npm run db:migrate --workspace server --",
        "db:deploy": "npm run db:deploy --workspace server --",
        "db:status": "npm run db:status --workspace server --",
        "db:seed": "npm run db:seed --workspace server --",
        "content:context": "npm run content:context --workspace server --",
        "admin:password": "npm run admin:password --workspace server --",
        "test": "npm run test --workspace server --",
        "test:db": "npm run test:db --workspace server --",
        "test:browser": "npm run build && npm run test:browser --workspace server"
    },
    "engines": {
        "node": "^22.12.0 || ^24.0.0"
    }
}
